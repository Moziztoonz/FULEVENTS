# ---------------------------------------------------------------------------
# Campus Events Platform - environment variables
# Copy this file to .env.local and fill in the values. Never commit .env.local.
# ---------------------------------------------------------------------------

# Public URL of the app. Used for share links and password reset links.
APP_URL=http://localhost:3000

# Secret used to sign nothing less than 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# Where the SQLite database file lives. Relative paths resolve from the project root.
DATABASE_PATH=data/fulafia.db

# Where uploaded event flyers are stored. Must be a writable, persistent directory.
UPLOAD_DIR=storage/uploads

# Seed accounts. Run `npm run db:seed` after setting these.
ADMIN_EMAIL=admin@fulafia.edu.ng
ADMIN_PASSWORD=change-this-before-deploying
ADMIN_NAME=Platform Administrator

# Password reset delivery.
# display = show the reset link on the forgot-password screen (default: no mail service).
# outbox  = hide it from the public and let an admin read it in /admin/messages.
# Every reset message is stored in the email_outbox table either way, so nothing is lost
# until an email provider (Resend, Postmark, SMTP) is wired up in src/lib/reset.ts.
PASSWORD_RESET_DELIVERY=display
